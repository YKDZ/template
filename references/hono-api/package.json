{
  "name": "@ykdz/reference-hono-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "source": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions=source --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@ykdz/template-core": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/reference-workspace-root": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
