{
  "name": "@ykdz/reference-npm-publication",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "publication:pack": "turbo run build && changeset pack --out-dir .changeset/packed",
    "publication:publish": "changeset publish --from-pack-dir .changeset/packed"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^24.21.0"
  }
}
