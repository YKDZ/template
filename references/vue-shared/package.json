{
  "name": "@ykdz/reference-vue-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "#tooling/*": "@ykdz/reference-typescript-config/*"
  },
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    },
    "./CounterButton.vue": {
      "types": "./dist/src/components/CounterButton.vue.d.ts",
      "default": "./src/components/CounterButton.vue"
    },
    "./counter": {
      "types": "./dist/src/stores/counter.d.ts",
      "default": "./src/stores/counter.ts"
    },
    "./mount": {
      "types": "./dist/src/mount.d.ts",
      "default": "./src/mount.ts"
    },
    "./style.css": "./src/style.css",
    "./vite": {
      "types": "./dist/tooling/vite.d.ts",
      "default": "./tooling/vite.ts"
    },
    "./vitest": {
      "types": "./dist/tooling/vitest.d.ts",
      "default": "./tooling/vitest.ts"
    },
    "./tsconfig.app.json": "./tsconfig.app.base.json",
    "./tsconfig.node.json": "./tsconfig.node.base.json"
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "vue-tsc --build --noEmit --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "browser:prepare": "playwright install chromium",
    "test:browser": "vitest run --project=browser --reporter=agent --silent=passed-only",
    "test": "vitest run --project=node --reporter=agent --silent=passed-only",
    "build": "vue-tsc -p tsconfig.build.json --pretty false"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/devtools-api": "catalog:",
    "@ykdz/template-core": "workspace:*",
    "pinia": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-bluetooth": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@ykdz/reference-typescript-config": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
