{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "browser:prepare": {
      "cache": false,
      "outputs": [],
      "tags": ["work:preparation"]
    },
    "format:check": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "cache": false,
      "dependsOn": ["lint:fix"],
      "outputs": [],
      "tags": ["work:repair"]
    },
    "lint": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "outputs": [],
      "tags": ["work:repair"]
    },
    "test": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:browser": {
      "cache": true,
      "dependsOn": ["browser:prepare"],
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "build:template": {
      "dependsOn": ["@ykdz/template-core#build"],
      "outputs": ["template-dist/**"],
      "tags": ["work:preparation"]
    }
  }
}
