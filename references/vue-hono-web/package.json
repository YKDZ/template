{
  "name": "@ykdz/reference-vue-hono-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    },
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "vue-tsc --build --noEmit --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "browser:prepare": "playwright install chromium",
    "test:browser": "vitest run --project=browser --reporter=agent --silent=passed-only",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ykdz/reference-hono-api": "workspace:*",
    "@ykdz/reference-vue-shared": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "pinia": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-bluetooth": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@ykdz/reference-typescript-config": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
