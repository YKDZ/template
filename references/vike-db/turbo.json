{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "db:seed:example": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "db:reset": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["//#database:prepare:test"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "build:template": {
      "dependsOn": [
        "@ykdz/template-core#build",
        "@ykdz/template-workspace#build"
      ],
      "outputs": ["template-dist/**"],
      "tags": ["quality:light"]
    },
    "typecheck:template": {
      "dependsOn": [
        "@ykdz/template-core#build",
        "@ykdz/template-workspace#build"
      ],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "check:author-planning-roles": {
      "cache": false,
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
