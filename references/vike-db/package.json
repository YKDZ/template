{
  "name": "@ykdz/reference-vike-db",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#db/*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#tooling/*": "@ykdz/reference-typescript-config/*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./queries/todos": {
      "source": "./src/queries/todos.ts",
      "types": "./dist/queries/todos.d.ts",
      "default": "./dist/queries/todos.js"
    },
    "./readiness": {
      "source": "./src/readiness.ts",
      "types": "./dist/readiness.d.ts",
      "default": "./dist/readiness.js"
    },
    "./schema": {
      "source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./storage": {
      "source": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts"
    },
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "build": "tsc -p tsconfig.build.json --pretty false",
    "db:reset": "node --conditions=source scripts/reset.ts",
    "db:seed:example": "node --conditions=source scripts/seed-example.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "DATABASE_PROFILE=test node --conditions=source --test --test-reporter=spec --test-reporter=#tooling/reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "typecheck:template": "tsc -p tsconfig.template.json --noEmit --pretty false"
  },
  "dependencies": {
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/reference-typescript-config": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
