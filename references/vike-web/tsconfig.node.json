{
  "extends": "@ykdz/reference-tooling-config/base.json",
  "compilerOptions": {
    "composite": true,
    "customConditions": [],
    "erasableSyntaxOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rewriteRelativeImportExtensions": false,
    "target": "es2024",
    "types": ["node"],
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.config.ts",
    "env.d.ts",
    "assets/**/*.svg",
    "components/**/*.vue",
    "pages/**/*.ts",
    "pages/**/*.vue",
    "server/**/*.ts",
    "+server.ts",
    "types/**/*.d.ts",
    "test/**/*.ts",
    "tooling/**/*.ts",
    "template/**/*.ts"
  ]
}
