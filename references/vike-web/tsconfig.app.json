{
  "extends": [
    "@vue/tsconfig/tsconfig.dom.json",
    "@ykdz/reference-tooling-config/base.json"
  ],
  "compilerOptions": {
    "composite": true,
    "customConditions": [],
    "exactOptionalPropertyTypes": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": false,
    "target": "es2024",
    "types": ["node"],
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "+server.ts",
    "assets/**/*.svg",
    "components/**/*.vue",
    "pages/**/*.ts",
    "pages/**/*.vue",
    "server/**/*.ts",
    "types/**/*.d.ts"
  ]
}
