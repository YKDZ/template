{
  "extends": "@ykdz/reference-typescript-config/base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "target": "es2024",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "drizzle.config.ts",
    "scripts/**/*.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
