{
  "name": "@ykdz/preset-vue-hono-app",
  "version": "0.0.0",
  "private": true,
  "files": [
    "template-dist",
    "resources"
  ],
  "type": "module",
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "build": "pnpm run build:template",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern template-dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern template-dist . --fix",
    "test": "node --conditions=source --experimental-strip-types --test --test-concurrency=2 --test-timeout=60000 'test/**/*.light.test.ts'",
    "test:e2e": "PLAYWRIGHT_API_PACKAGE_NAME=@ykdz/reference-hono-api PLAYWRIGHT_WEB_PACKAGE_NAME=@ykdz/reference-vue-hono-web playwright test --config resources/joint-e2e/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/reference-hono-api": "workspace:*",
    "@ykdz/reference-vue-hono-web": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/reference-ts-cli": "workspace:*",
    "@ykdz/reference-ts-lib": "workspace:*",
    "@ykdz/reference-vue-shared": "workspace:*",
    "@ykdz/template-generator": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:"
  }
}
