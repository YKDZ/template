{
  "extends": "./tsconfig.app.base.json",
  "compilerOptions": {
    "customConditions": [],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "web-bluetooth"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "scripts/**/*.ts",
    "tooling/**/*.ts"
  ]
}
