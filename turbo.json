{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "signature": true
  },
  "boundaries": {
    "tags": {
      "template-checks": {
        "dependencies": {
          "allow": [
            "template-checks",
            "template-core",
            "template-builtin-presets"
          ]
        }
      },
      "template-builtin-presets": {
        "dependencies": {
          "allow": [
            "template-builtin-presets",
            "template-core",
            "template-checks"
          ]
        }
      },
      "template-cli": {
        "dependencies": {
          "allow": [
            "template-cli",
            "template-builtin-presets",
            "template-core",
            "template-checks"
          ]
        }
      },
      "template-core": {
        "dependencies": {
          "allow": [
            "template-core",
            "template-builtin-presets",
            "template-checks"
          ]
        }
      },
      "template-root": {
        "dependencies": {
          "allow": [
            "template-root",
            "template-checks",
            "template-cli",
            "template-builtin-presets",
            "template-core"
          ]
        }
      }
    }
  },
  "globalPassThroughEnv": [
    "TMPDIR",
    "DOCKER_CONFIG",
    "BUILDX_CONFIG",
    "BUILDX_BUILDER",
    "PNPM_CONFIG_STORE_DIR",
    "PNPM_CONFIG_CACHE_DIR"
  ],
  "concurrency": "2",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "tags": ["quality:light"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"]
    },
    "check:fixtures": {
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "TEMPLATE_FIXTURE_BUILDKIT_CACHE_DIR",
        "TEMPLATE_FIXTURE_CARGO_CACHE_DIR",
        "TEMPLATE_FIXTURE_CONCURRENCY",
        "TEMPLATE_FIXTURE_DEVELOPMENT_CONTAINER_SESSIONS",
        "TEMPLATE_FIXTURE_EVIDENCE_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_READ",
        "TEMPLATE_FIXTURE_EVIDENCE_WRITE",
        "TEMPLATE_FIXTURE_EVIDENCE_ACTIVITY_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ID",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ATTEMPT",
        "TEMPLATE_FIXTURE_PNPM_CACHE_DIR",
        "TEMPLATE_FIXTURE_WORKSPACE_DIR",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_READ_ONLY",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_SIGNATURE_KEY",
        "TEMPLATE_FIXTURE_TURBO_TEAM",
        "TEMPLATE_FIXTURE_TURBO_TOKEN"
      ]
    },
    "check:generated": {
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "TEMPLATE_FIXTURE_BUILDKIT_CACHE_DIR",
        "TEMPLATE_FIXTURE_CARGO_CACHE_DIR",
        "TEMPLATE_FIXTURE_CONCURRENCY",
        "TEMPLATE_FIXTURE_DEVELOPMENT_CONTAINER_SESSIONS",
        "TEMPLATE_FIXTURE_EVIDENCE_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_READ",
        "TEMPLATE_FIXTURE_EVIDENCE_WRITE",
        "TEMPLATE_FIXTURE_EVIDENCE_ACTIVITY_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ID",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ATTEMPT",
        "TEMPLATE_FIXTURE_PNPM_CACHE_DIR",
        "TEMPLATE_FIXTURE_WORKSPACE_DIR",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_READ_ONLY",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_SIGNATURE_KEY",
        "TEMPLATE_FIXTURE_TURBO_TEAM",
        "TEMPLATE_FIXTURE_TURBO_TOKEN"
      ]
    },
    "check:focused": {
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "TEMPLATE_FIXTURE_BUILDKIT_CACHE_DIR",
        "TEMPLATE_FIXTURE_CARGO_CACHE_DIR",
        "TEMPLATE_FIXTURE_CONCURRENCY",
        "TEMPLATE_FIXTURE_DEVELOPMENT_CONTAINER_SESSIONS",
        "TEMPLATE_FIXTURE_EVIDENCE_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_READ",
        "TEMPLATE_FIXTURE_EVIDENCE_WRITE",
        "TEMPLATE_FIXTURE_EVIDENCE_ACTIVITY_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ID",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ATTEMPT",
        "TEMPLATE_FIXTURE_PNPM_CACHE_DIR",
        "TEMPLATE_FIXTURE_WORKSPACE_DIR",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_READ_ONLY",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_SIGNATURE_KEY",
        "TEMPLATE_FIXTURE_TURBO_TEAM",
        "TEMPLATE_FIXTURE_TURBO_TOKEN"
      ]
    },
    "check:deployment": {
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "TEMPLATE_FIXTURE_BUILDKIT_CACHE_DIR",
        "TEMPLATE_FIXTURE_CARGO_CACHE_DIR",
        "TEMPLATE_FIXTURE_CONCURRENCY",
        "TEMPLATE_FIXTURE_DEVELOPMENT_CONTAINER_SESSIONS",
        "TEMPLATE_FIXTURE_EVIDENCE_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_READ",
        "TEMPLATE_FIXTURE_EVIDENCE_WRITE",
        "TEMPLATE_FIXTURE_EVIDENCE_ACTIVITY_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ID",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ATTEMPT",
        "TEMPLATE_FIXTURE_PNPM_CACHE_DIR",
        "TEMPLATE_FIXTURE_WORKSPACE_DIR",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_READ_ONLY",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_SIGNATURE_KEY",
        "TEMPLATE_FIXTURE_TURBO_TEAM",
        "TEMPLATE_FIXTURE_TURBO_TOKEN"
      ]
    },
    "check:templates": {
      "tags": ["quality:heavy"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "check:templates:boundary": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "check:templates:github-yaml": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "check:evidence-health": {
      "tags": ["quality:conditional"],
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "tags": ["quality:light"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxfmt.config.ts"],
      "outputs": []
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false
    },
    "lint": {
      "tags": ["quality:light"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"],
      "outputs": []
    },
    "lint:fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "test": {
      "tags": ["quality:light"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:integration": {
      "tags": ["quality:heavy"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:packed-publication": {
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [".verified-packed-publication/**"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "TEMPLATE_VERIFIED_PACKED_ARTIFACT_DIR"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "tags": ["quality:heavy"],
      "cache": false
    },
    "prepack": {
      "tags": ["work:lifecycle"],
      "cache": false
    },
    "pack:bundled": {
      "tags": ["work:release"],
      "cache": false
    },
    "//#format:check": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false
    },
    "//#lint": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#lint:fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#test": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:light"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "//#test:integration": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:heavy"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "//#test:packed-publication": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [".verified-packed-publication/**"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "TEMPLATE_VERIFIED_PACKED_ARTIFACT_DIR",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR"
      ]
    },
    "//#check": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:heavy": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:full": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:toolchain:versions": {
      "tags": ["quality:light"],
      "cache": false,
      "outputs": []
    },
    "//#sync:toolchain": {
      "tags": ["work:preparation"],
      "cache": false
    },
    "//#boundaries": {
      "tags": ["quality:light"],
      "cache": false,
      "outputs": []
    },
    "//#fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#build": {
      "tags": ["work:preparation"],
      "cache": false
    }
  }
}
