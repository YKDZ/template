{
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": [
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "library": {
        "dependencies": {
          "allow": [
            "library",
            "app",
            "native",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-core": {
        "dependencies": {
          "allow": [
            "template-core",
            "template-generator",
            "app",
            "native",
            "library",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-environment": {
        "dependencies": {
          "allow": [
            "template-environment",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-workspace": {
        "dependencies": {
          "allow": [
            "template-workspace",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace-authoring"
          ]
        }
      },
      "template-workspace-authoring": {
        "dependencies": {
          "allow": [
            "template-workspace-authoring",
            "app",
            "native",
            "library",
            "template-builtin-presets",
            "template-checks",
            "template-workspace",
            "template-root",
            "template-core",
            "template-generator",
            "template-environment",
            "template-cli"
          ]
        }
      },
      "template-builtin-presets": {
        "dependencies": {
          "allow": [
            "template-builtin-presets",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-cli": {
        "dependencies": {
          "allow": [
            "template-cli",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-checks": {
        "dependencies": {
          "allow": [
            "template-checks",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      },
      "template-root": {
        "dependencies": {
          "allow": [
            "template-root",
            "app",
            "native",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-cli",
            "template-workspace-authoring"
          ]
        }
      },
      "native": {
        "dependencies": {
          "allow": [
            "native",
            "app",
            "library",
            "template-core",
            "template-generator",
            "template-builtin-presets",
            "template-checks",
            "template-environment",
            "template-workspace",
            "template-workspace-authoring"
          ]
        }
      }
    }
  },
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "RUSTUP_HOME",
    "RUSTUP_TOOLCHAIN",
    "TMPDIR",
    "DOCKER_CONFIG",
    "BUILDX_CONFIG",
    "BUILDX_BUILDER",
    "PNPM_CONFIG_STORE_DIR",
    "PNPM_CONFIG_CACHE_DIR",
    "HTTPS_PROXY",
    "https_proxy",
    "NO_PROXY",
    "no_proxy"
  ],
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#sync:workspace-policy": {
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "//#check:workspace-policy": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#build": {
      "tags": ["work:preparation"]
    },
    "//#check:toolchain:versions": {
      "cache": false,
      "tags": ["quality:light"]
    },
    "//#sync:repository": {
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "//#check:repository:config": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#check:development-container": {
      "cache": false,
      "tags": ["quality:heavy"],
      "passThroughEnv": ["NODE_USE_ENV_PROXY"]
    },
    "//#test": {
      "outputs": [],
      "tags": ["quality:light"],
      "dependsOn": ["@ykdz/template#build"]
    },
    "//#test:integration": {
      "cache": false,
      "tags": ["quality:heavy"],
      "dependsOn": ["@ykdz/template#build"]
    },
    "//#test:packed-publication": {
      "cache": false,
      "tags": ["quality:heavy"],
      "dependsOn": ["@ykdz/template-checks#build", "@ykdz/template#build"],
      "passThroughEnv": [
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR",
        "TEMPLATE_VERIFIED_PACKED_ARTIFACT_DIR"
      ],
      "outputs": [".verified-packed-publication/**"]
    },
    "//#test:e2e:cli": {
      "cache": false,
      "tags": ["quality:heavy"],
      "passThroughEnv": ["TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR"]
    },
    "//#database:prepare:dev": {
      "cache": false,
      "tags": ["work:preparation"],
      "dependsOn": ["@ykdz/reference-vike-db#build"]
    },
    "//#database:prepare:e2e": {
      "cache": false,
      "tags": ["work:preparation"],
      "dependsOn": ["@ykdz/reference-vike-db#build"]
    },
    "//#database:prepare:test": {
      "cache": false,
      "tags": ["work:preparation"],
      "dependsOn": ["@ykdz/reference-vike-db#build"]
    },
    "//#test:e2e:vue-hono": {
      "cache": false,
      "tags": ["quality:heavy"],
      "dependsOn": [
        "@ykdz/reference-hono-api#build",
        "@ykdz/reference-vue-hono-web#build",
        "@ykdz/reference-vue-hono-web#browser:prepare"
      ]
    },
    "//#toolchain:prepare": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "//#sync": {
      "cache": false,
      "tags": ["work:on-demand"]
    }
  },
  "tags": ["template-root"],
  "remoteCache": {
    "signature": true
  },
  "concurrency": "2"
}
