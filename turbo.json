{
  "$schema": "https://turborepo.com/schema.json",
  "tags": ["template-root"],
  "remoteCache": {
    "signature": true
  },
  "boundaries": {
    "tags": {
      "template-checks": {
        "dependencies": {
          "allow": [
            "template-checks",
            "template-core",
            "template-builtin-presets"
          ]
        }
      },
      "template-builtin-presets": {
        "dependencies": {
          "allow": [
            "template-builtin-presets",
            "template-core",
            "template-checks"
          ]
        }
      },
      "template-cli": {
        "dependencies": {
          "allow": [
            "template-cli",
            "template-builtin-presets",
            "template-core",
            "template-checks"
          ]
        }
      },
      "template-core": {
        "dependencies": {
          "allow": [
            "template-core",
            "template-builtin-presets",
            "template-checks"
          ]
        }
      },
      "template-root": {
        "dependencies": {
          "allow": [
            "template-root",
            "template-checks",
            "template-cli",
            "template-builtin-presets",
            "template-core"
          ]
        }
      }
    }
  },
  "globalPassThroughEnv": [
    "TMPDIR",
    "DOCKER_CONFIG",
    "BUILDX_CONFIG",
    "BUILDX_BUILDER",
    "PNPM_CONFIG_STORE_DIR",
    "PNPM_CONFIG_CACHE_DIR"
  ],
  "concurrency": "2",
  "tasks": {
    "//#format:check": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false
    },
    "//#lint": {
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#lint:fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "outputs": []
    },
    "//#test": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:light"],
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "//#test:integration": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:heavy"],
      "outputs": [],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "TEMPLATE_BUILTIN_PRESET_DIAGNOSTICS_DIR"
      ]
    },
    "//#test:packed-publication": {
      "dependsOn": ["@ykdz/template#build"],
      "tags": ["quality:heavy"],
      "cache": false,
      "outputs": [".verified-packed-publication/**"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "RUSTUP_TOOLCHAIN",
        "TEMPLATE_VERIFIED_PACKED_ARTIFACT_DIR",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR"
      ]
    },
    "//#check": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:heavy": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:full": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:toolchain:versions": {
      "tags": ["quality:light"],
      "cache": false,
      "outputs": []
    },
    "//#sync:toolchain": {
      "tags": ["work:preparation"],
      "cache": false
    },
    "//#boundaries": {
      "tags": ["quality:light"],
      "cache": false,
      "outputs": []
    },
    "//#fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#build": {
      "tags": ["work:preparation"],
      "cache": false
    }
  }
}
