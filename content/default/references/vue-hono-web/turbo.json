{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "browser:prepare": {
      "cache": false,
      "outputs": [],
      "tags": ["work:preparation"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["@ykdz/reference-hono-api#build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "dev": {
      "cache": false,
      "outputs": [],
      "tags": ["work:development"]
    },
    "format:check": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "cache": false,
      "dependsOn": ["lint:fix"],
      "outputs": [],
      "tags": ["work:repair"]
    },
    "lint": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "outputs": [],
      "tags": ["work:repair"]
    },
    "preview": {
      "cache": false,
      "outputs": [],
      "tags": ["work:development"]
    },
    "test:browser": {
      "cache": true,
      "dependsOn": ["browser:prepare"],
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["@ykdz/reference-hono-api#build", "^typecheck"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "build:template": {
      "dependsOn": [
        "@ykdz/reference-hono-api#build",
        "@ykdz/template-core#build",
        "@ykdz/default-content-authoring#build"
      ],
      "outputs": ["template-dist/**"],
      "tags": ["work:preparation"]
    },
    "check:author-planning-roles": {
      "cache": false,
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
