{
  "name": "@ykdz/reference-ts-cli",
  "private": true,
  "bin": {
    "reference-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./reference": "./package.json",
    "./template": {
      "source": "./template/definition.ts",
      "types": "./template-dist/definition.d.ts",
      "default": "./template-dist/definition.js"
    },
    "./command-identity": {
      "source": "./src/publication/cli-command-identity.ts",
      "types": "./dist/publication/cli-command-identity.d.ts",
      "default": "./dist/publication/cli-command-identity.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "build:template": "rm -rf template-dist && tsc -p tsconfig.template.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "postbuild": "node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "node --conditions=source --test --test-reporter=spec 'test/unit/**/*.test.ts' 'test/integration/**/*.test.ts'",
    "test:e2e": "node --conditions=source --test --test-timeout=180000 --test-reporter=spec 'test/e2e/source-journeys.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/default-content-authoring": "workspace:*",
    "@ykdz/reference-npm-publication": "workspace:*",
    "@ykdz/reference-tooling-config": "link:../tooling-config",
    "@ykdz/reference-workspace-root": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/tooling-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^24.21.0"
  }
}
