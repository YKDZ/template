{
  "extends": "@ykdz/tooling-config/node.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.config.tsbuildinfo"
  },
  "include": ["*.config.ts", "test/**/*.ts"]
}
