{
  "tasks": {
    "//#database:prepare:dev": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "//#database:prepare:test": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "//#database:prepare:e2e": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "{{DATABASE_PACKAGE}}#test": {
      "dependsOn": ["//#database:prepare:test"],
      "tags": ["quality:light"]
    },
    "{{MIGRATION_PACKAGE}}#typecheck": {
      "dependsOn": ["{{DATABASE_PACKAGE}}#build"],
      "tags": ["quality:light"]
    },
    "{{APPLICATION_DEV_PACKAGE}}#typecheck": {
      "dependsOn": ["{{DATABASE_PACKAGE}}#build"],
      "tags": ["quality:light"]
    },
    "{{APPLICATION_DEV_PACKAGE}}#dev": {
      "dependsOn": ["{{DATABASE_PACKAGE}}#build"],
      "cache": false,
      "persistent": true,
      "tags": ["work:development"]
    },
    "{{APPLICATION_E2E_PACKAGE}}#test:e2e": {
      "dependsOn": [
        "//#database:prepare:e2e",
        "{{DATABASE_PACKAGE}}#build",
        "build",
        "browser:prepare"
      ],
      "cache": false,
      "tags": ["quality:heavy"]
    }
  }
}
