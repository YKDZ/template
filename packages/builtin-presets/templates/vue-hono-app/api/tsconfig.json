{
  "extends": "{{TYPESCRIPT_CONFIG_PACKAGE}}/base.json",
  "compilerOptions": {
    "composite": true,
    "customConditions": ["source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "target": "es2024",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
