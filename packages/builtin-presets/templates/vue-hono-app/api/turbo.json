{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "dev": {
      "cache": false,
      "outputs": [],
      "tags": ["work:development"]
    },
    "format:check": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "cache": false,
      "dependsOn": ["lint:fix"],
      "outputs": [],
      "tags": ["work:repair"]
    },
    "lint": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "outputs": [],
      "tags": ["work:repair"]
    },
    "start": {
      "cache": false,
      "outputs": [],
      "tags": ["work:development"]
    },
    "test": {
      "cache": true,
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
