{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "db:generate": {
      "cache": false,
      "tags": ["work:development"]
    },
    "db:migrate": {
      "cache": false,
      "tags": ["work:lifecycle"]
    },
    "db:prepare:deploy": {
      "cache": false,
      "tags": ["work:lifecycle"]
    },
    "db:push": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "db:studio": {
      "cache": false,
      "tags": ["work:development"]
    },
    "format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["{{DATABASE_PACKAGE_NAME}}#build"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
