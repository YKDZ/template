{
  "extends": "{{TYPESCRIPT_CONFIG_PACKAGE}}/base.json",
  "compilerOptions": {
    "composite": true,
    "customConditions": ["source"],
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "skipLibCheck": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
