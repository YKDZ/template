{
  "extends": ["//"],
  "tags": ["template-builtin-presets"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxfmt.config.ts"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.template-source.config.ts"
      ],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:integration": {
      "dependsOn": [],
      "tags": ["quality:heavy"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "env": ["RUSTUP_TOOLCHAIN"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "TEMPLATE_BUILTIN_PRESET_DIAGNOSTICS_DIR"
      ]
    }
  }
}
