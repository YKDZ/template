{
  "extends": ["//"],
  "tags": ["template-builtin-presets"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@ykdz/template-core#build",
        "@ykdz/template-environment#build",
        "@ykdz/template-generator#build",
        "@ykdz/template-workspace#build",
        "@ykdz/reference-hono-api#build:template",
        "@ykdz/reference-rust-bin#build:template",
        "@ykdz/reference-ts-cli#build:template",
        "@ykdz/reference-ts-lib#build:template",
        "@ykdz/reference-typescript-config#build:template",
        "@ykdz/reference-vike-db#build:template",
        "@ykdz/reference-vike-migrations#build:template",
        "@ykdz/reference-vike-web#build:template",
        "@ykdz/reference-vue-app#build:template",
        "@ykdz/reference-vue-hono-web#build:template",
        "@ykdz/reference-vue-shared#build:template"
      ],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:integration": {
      "dependsOn": [],
      "tags": ["quality:heavy"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "env": ["RUSTUP_TOOLCHAIN"],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME",
        "TEMPLATE_BUILTIN_PRESET_DIAGNOSTICS_DIR"
      ]
    }
  }
}
