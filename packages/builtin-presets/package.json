{
  "name": "@ykdz/template-builtin-presets",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "imports": {
    "#npm-publication/*": "./templates/ts-cli/publication/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern dist --ignore-pattern templates . && oxlint --quiet --format=unix --config ../../oxlint.config.ts templates/ts-cli/publication-setup/bridge.ts",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts --ignore-pattern dist --ignore-pattern templates . --fix && oxlint --format=unix --config ../../oxlint.config.ts templates/ts-cli/publication-setup/bridge.ts --fix",
    "test": "vitest run --config vitest.config.ts --reporter=agent --silent=passed-only --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/template-core": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "npm-package-arg": "^13.0.2",
    "picomatch": "^4.0.5",
    "semver": "catalog:",
    "smol-toml": "^1.8.0",
    "unbash": "4.0.11",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@playwright/test": "catalog:",
    "@pnpm/workspace.package-patterns": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "^6.1.4",
    "@types/picomatch": "^3.0.2",
    "@types/semver": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "@types/web-bluetooth": "catalog:",
    "@vikejs/hono": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/devtools-api": "catalog:",
    "@vue/tsconfig": "catalog:",
    "commander": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "execa": "catalog:",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pinia": "catalog:",
    "shell-quote": "catalog:",
    "spdx-expression-parse": "catalog:",
    "tailwindcss": "catalog:",
    "tar": "catalog:",
    "telefunc": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vike": "catalog:",
    "vike-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6 <7"
  },
  "bundleDependencies": [
    "jsonc-parser",
    "npm-package-arg",
    "picomatch",
    "semver",
    "smol-toml",
    "unbash",
    "yaml"
  ],
  "turbo": {
    "tags": [
      "template-builtin-presets"
    ]
  }
}
