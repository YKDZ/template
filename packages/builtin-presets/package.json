{
  "name": "@ykdz/template-builtin-presets",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "imports": {
    "#npm-publication/*": "./templates/ts-cli/publication/*.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./quality-gates": {
      "source": "./templates/foundation/scripts/quality-gates.ts",
      "types": "./templates/foundation/scripts/quality-gates.ts",
      "default": "./templates/foundation/scripts/quality-gates.ts"
    },
    "./node-test-count-reporter": {
      "source": "./templates/foundation/scripts/node-test-count-reporter.ts",
      "types": "./templates/foundation/scripts/node-test-count-reporter.ts",
      "default": "./templates/foundation/scripts/node-test-count-reporter.ts"
    },
    "./turbo-boundaries": {
      "source": "./templates/foundation/scripts/run-turbo-boundaries.ts",
      "types": "./templates/foundation/scripts/run-turbo-boundaries.ts",
      "default": "./templates/foundation/scripts/run-turbo-boundaries.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern dist --ignore-pattern templates . && oxlint --quiet --format=unix --config ../../oxlint.config.ts templates/ts-cli/publication-setup/bridge.ts && oxlint --quiet --format=unix --config ../../oxlint.template-source.config.ts templates/foundation/scripts/quality-gates.ts templates/foundation/scripts/node-test-count-reporter.ts templates/foundation/scripts/run-turbo-boundaries.ts",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts --ignore-pattern dist --ignore-pattern templates . --fix && oxlint --format=unix --config ../../oxlint.config.ts templates/ts-cli/publication-setup/bridge.ts --fix && oxlint --format=unix --config ../../oxlint.template-source.config.ts templates/foundation/scripts/quality-gates.ts templates/foundation/scripts/node-test-count-reporter.ts templates/foundation/scripts/run-turbo-boundaries.ts --fix",
    "test": "node --conditions=source --experimental-strip-types --import=./test-support/setup.ts --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter=@ykdz/template-builtin-presets/node-test-count-reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'src/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --experimental-strip-types scripts/run-installed-integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.template-scripts.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/template-core": "workspace:*",
    "jsonc-parser": "^3.3.1",
    "npm-package-arg": "^14.0.0",
    "picomatch": "^4.0.7",
    "semver": "catalog:",
    "smol-toml": "^1.8.0",
    "unbash": "5.0.0",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@hono/node-server": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "^6.1.4",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "@types/web-bluetooth": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "@vikejs/hono": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/devtools-api": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "execa": "catalog:",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pinia": "catalog:",
    "spdx-expression-parse": "catalog:",
    "tailwindcss": "catalog:",
    "tar": "catalog:",
    "telefunc": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vike": "catalog:",
    "vike-vue": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6 <7"
  },
  "bundleDependencies": [
    "jsonc-parser",
    "npm-package-arg",
    "picomatch",
    "semver",
    "smol-toml",
    "unbash",
    "yaml"
  ]
}
