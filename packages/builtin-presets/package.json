{
  "name": "@ykdz/template-builtin-presets",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "scripts/node-test-count-reporter.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./development-environment": {
      "source": "./src/shared/development-container.ts",
      "types": "./dist/src/shared/development-container.d.ts",
      "default": "./dist/src/shared/development-container.js"
    },
    "./node-test-count-reporter": {
      "source": "./scripts/node-test-count-reporter.ts",
      "types": "./scripts/node-test-count-reporter.ts",
      "default": "./scripts/node-test-count-reporter.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node --conditions=source scripts/build-reference-payload.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "test": "node --conditions=source --experimental-strip-types --import=./test-support/setup.ts --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter=@ykdz/template-builtin-presets/node-test-count-reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'src/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --experimental-strip-types scripts/run-installed-integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-generator": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "jsonc-parser": "catalog:",
    "npm-package-arg": "catalog:",
    "picomatch": "catalog:",
    "semver": "catalog:",
    "smol-toml": "catalog:",
    "unbash": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/semver": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "@ykdz/reference-hono-api": "workspace:*",
    "@ykdz/reference-rust-bin": "workspace:*",
    "@ykdz/reference-ts-cli": "workspace:*",
    "@ykdz/reference-ts-lib": "workspace:*",
    "@ykdz/reference-typescript-config": "workspace:*",
    "@ykdz/reference-vike-db": "workspace:*",
    "@ykdz/reference-vike-migrations": "workspace:*",
    "@ykdz/reference-vike-web": "workspace:*",
    "@ykdz/reference-vue-app": "workspace:*",
    "@ykdz/reference-vue-hono-web": "workspace:*",
    "@ykdz/reference-vue-shared": "workspace:*",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "spdx-expression-parse": "catalog:",
    "tar": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=6 <7"
  },
  "bundleDependencies": [
    "jsonc-parser",
    "npm-package-arg",
    "picomatch",
    "semver",
    "smol-toml",
    "unbash",
    "yaml"
  ]
}
