{
  "name": "@ykdz/template-core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.light.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "ignore": "catalog:",
    "jsonc-parser": "catalog:",
    "node-diff3": "catalog:",
    "toml-eslint-parser": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/tooling-config": "workspace:*",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:"
  }
}
