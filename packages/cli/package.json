{
  "name": "@ykdz/template",
  "version": "0.0.38",
  "private": false,
  "description": "Project template generator for YKDZ starter projects.",
  "keywords": [
    "cli",
    "project-template",
    "starter"
  ],
  "homepage": "https://github.com/YKDZ/template#readme",
  "bugs": {
    "url": "https://github.com/YKDZ/template/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/template.git"
  },
  "bin": {
    "template": "dist/cli.js"
  },
  "files": [
    "dist",
    "node_modules/@ykdz/template-core",
    "node_modules/@ykdz/template-builtin-presets",
    "!**/node_modules/**/node_modules"
  ],
  "type": "module",
  "imports": {
    "#main": {
      "source": "./src/main.ts",
      "types": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts --ignore-pattern dist . --fix",
    "prepack": "pnpm exec turbo run build --filter=.",
    "pack:bundled": "pnpm --config.node-linker=hoisted pack",
    "publish:bundled": "pnpm --config.node-linker=hoisted publish",
    "test": "vitest run --config vitest.config.ts test/unit test/integration --reporter=verbose",
    "test:e2e": "node --conditions=source test/e2e/check-source-and-distribution.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "@ykdz/template-builtin-presets": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "hosted-git-info": "^10.0.0",
    "lru-cache": "^11.5.3",
    "node-diff3": "catalog:",
    "npm-package-arg": "^14.0.0",
    "picomatch": "^4.0.7",
    "proc-log": "^7.0.0",
    "semver": "catalog:",
    "typescript": "catalog:public-cli-runtime",
    "valibot": "catalog:",
    "validate-npm-package-name": "^8.0.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "bundleDependencies": [
    "@valibot/to-json-schema",
    "@ykdz/cli-contract",
    "@ykdz/template-builtin-presets",
    "@ykdz/template-core",
    "hosted-git-info",
    "lru-cache",
    "node-diff3",
    "npm-package-arg",
    "picomatch",
    "proc-log",
    "typescript",
    "validate-npm-package-name",
    "yaml"
  ],
  "engines": {
    "node": "^24.21.0"
  },
  "turbo": {
    "tags": [
      "template-cli"
    ]
  }
}
