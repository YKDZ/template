{
  "name": "@ykdz/template",
  "version": "0.1.0-experimental.1",
  "private": false,
  "description": "Project template generator for YKDZ starter projects.",
  "keywords": [
    "cli",
    "project-template",
    "starter"
  ],
  "homepage": "https://github.com/YKDZ/template#readme",
  "bugs": {
    "url": "https://github.com/YKDZ/template/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/template.git"
  },
  "bin": {
    "template": "dist/cli.js"
  },
  "files": [
    "dist",
    "!**/node_modules/**/node_modules"
  ],
  "type": "module",
  "imports": {
    "#main": {
      "source": "./src/main.ts",
      "types": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "directory": ".package"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "prepack": "pnpm run build:distribution",
    "test": "node --conditions=source --experimental-strip-types --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --experimental-strip-types --test --test-concurrency=1 --test-timeout=300000 --test-reporter=spec 'test/**/*.integration.test.ts'",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.scripts.json --noEmit --pretty false",
    "test:e2e:packed": "node --conditions=source --test --test-reporter=tap test/e2e/run-journeys.ts test/e2e/packed-failure.test.ts",
    "test:e2e:source": "TEMPLATE_CLI_JOURNEY_MODE=source node --conditions=source --test --test-reporter=tap test/e2e/run-journeys.ts",
    "test:e2e:distribution": "node --test --test-reporter=tap test/e2e/run-journeys.ts",
    "test:e2e:resolution": "node --conditions=source test/e2e/assert-source-resolutions.ts",
    "build:distribution": "pnpm exec turbo run build --filter=. && node --conditions=source scripts/prepare-distribution.ts"
  },
  "dependencies": {
    "@valibot/to-json-schema": "catalog:",
    "@ykdz/cli-contract": "catalog:",
    "@ykdz/reference-npm-publication": "workspace:*",
    "@ykdz/template-content": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-generator": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "hosted-git-info": "catalog:",
    "ignore": "catalog:",
    "lru-cache": "catalog:",
    "node-diff3": "catalog:",
    "npm-package-arg": "catalog:",
    "picomatch": "catalog:",
    "proc-log": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:public-cli-runtime",
    "valibot": "catalog:",
    "validate-npm-package-name": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "bundleDependencies": [
    "@valibot/to-json-schema",
    "@ykdz/cli-contract",
    "hosted-git-info",
    "ignore",
    "lru-cache",
    "node-diff3",
    "npm-package-arg",
    "picomatch",
    "proc-log",
    "typescript",
    "validate-npm-package-name",
    "yaml"
  ],
  "engines": {
    "node": "^24.21.0"
  }
}
