{
  "extends": ["//"],
  "tags": ["template-cli"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "tags": ["work:preparation"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "publication:prepare": {
      "dependsOn": ["build"],
      "tags": ["work:preparation"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "PUBLICATION_ARTIFACT_OUTPUT_DIRECTORY",
        "TEMPLATE_VERIFIED_PACKED_ARTIFACT_DIR",
        "PUBLICATION_SOURCE_SHA",
        "GITHUB_DEFAULT_BRANCH"
      ]
    },
    "publication:verify": {
      "dependsOn": [],
      "tags": ["work:preparation"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "prepack": {
      "dependsOn": [],
      "tags": ["work:lifecycle"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:integration": {
      "dependsOn": [],
      "tags": ["quality:heavy"],
      "cache": true,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "test:e2e:source": {
      "dependsOn": [],
      "tags": ["quality:conditional"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "TEMPLATE_CLI_JOURNEY_MODE",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR",
        "TEMPLATE_CLI_JOURNEY_WORKER_PID_FILE"
      ]
    },
    "test:e2e:distribution": {
      "dependsOn": [],
      "tags": ["quality:conditional"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "TEMPLATE_CLI_JOURNEY_MODE",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR",
        "TEMPLATE_CLI_JOURNEY_WORKER_PID_FILE"
      ]
    },
    "test:e2e:resolution": {
      "dependsOn": [],
      "tags": ["quality:conditional"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "TEMPLATE_CLI_JOURNEY_MODE",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR",
        "TEMPLATE_CLI_JOURNEY_WORKER_PID_FILE"
      ]
    },
    "test:e2e:packed": {
      "dependsOn": [],
      "tags": ["quality:conditional"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "TEMPLATE_CLI_JOURNEY_MODE",
        "TEMPLATE_CLI_PACKED_BIN",
        "TEMPLATE_CLI_JOURNEY_DIAGNOSTICS_DIR",
        "TEMPLATE_CLI_JOURNEY_WORKER_PID_FILE"
      ]
    }
  }
}
