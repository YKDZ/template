{
  "extends": ["//"],
  "tags": ["template-content"],
  "tasks": {
    "build": {
      "dependsOn": [
        "@ykdz/template-core#build",
        "@ykdz/template-environment#build",
        "@ykdz/template-generator#build",
        "@ykdz/template-workspace#build",
        "@ykdz/preset-rust-bin#build",
        "@ykdz/preset-ts-cli#build",
        "@ykdz/preset-ts-lib#build",
        "@ykdz/preset-vike-app#build",
        "@ykdz/reference-rust-bin#build:template",
        "@ykdz/reference-ts-cli#build:template",
        "@ykdz/reference-ts-lib#build:template",
        "@ykdz/reference-typescript-config#build:template",
        "@ykdz/reference-vike-db#build:template",
        "@ykdz/reference-vike-migrations#build:template",
        "@ykdz/reference-vike-web#build:template",
        "@ykdz/template-workspace-authoring#build",
        "@ykdz/preset-vue-app#build",
        "@ykdz/reference-vue-app#build:template",
        "@ykdz/reference-vue-shared#build:template",
        "@ykdz/preset-vue-hono-app#build",
        "@ykdz/reference-hono-api#build:template",
        "@ykdz/reference-vue-hono-web#build:template"
      ],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "test:integration": {
      "dependsOn": ["build"],
      "tags": ["quality:heavy"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    }
  }
}
