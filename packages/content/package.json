{
  "name": "@ykdz/template-content",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifact-builder": {
      "types": "./scripts/build-content-artifacts.ts",
      "artifact-builder": "./scripts/build-content-artifacts.ts",
      "source": "./scripts/build-content-artifacts.ts"
    },
    "./collection": {
      "source": "./src/collection.ts",
      "types": "./dist/collection.d.ts",
      "default": "./dist/collection.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "test": "node --conditions=source --experimental-strip-types --test --test-concurrency=2 --test-timeout=60000 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=artifact-builder --experimental-strip-types --test --test-concurrency=1 --test-timeout=300000 'test/**/*.integration.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/preset-rust-bin": "workspace:*",
    "@ykdz/preset-ts-cli": "workspace:*",
    "@ykdz/preset-ts-lib": "workspace:*",
    "@ykdz/preset-vike-app": "workspace:*",
    "@ykdz/preset-vue-app": "workspace:*",
    "@ykdz/preset-vue-hono-app": "workspace:*",
    "@ykdz/reference-hono-api": "workspace:*",
    "@ykdz/reference-rust-bin": "workspace:*",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/reference-ts-cli": "workspace:*",
    "@ykdz/reference-ts-lib": "workspace:*",
    "@ykdz/reference-vike-db": "workspace:*",
    "@ykdz/reference-vike-migrations": "workspace:*",
    "@ykdz/reference-vike-web": "workspace:*",
    "@ykdz/reference-vue-app": "workspace:*",
    "@ykdz/reference-vue-hono-web": "workspace:*",
    "@ykdz/reference-vue-shared": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-generator": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  }
}
