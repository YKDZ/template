{
  "name": "@ykdz/tooling-config",
  "version": "0.0.0",
  "private": true,
  "files": [
    "base.json",
    "node.json",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ],
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./node.json": "./node.json",
    "./oxfmt": "./oxfmt.config.ts",
    "./oxlint": "./oxlint.config.ts",
    "./reference": "./package.json"
  },
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
