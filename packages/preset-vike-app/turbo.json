{
  "extends": ["//"],
  "tags": ["template-preset"],
  "tasks": {
    "build": {
      "dependsOn": ["build:template"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["template-dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "test": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "test:integration": {
      "dependsOn": [],
      "tags": ["quality:heavy"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "persistent": false
    },
    "build:template": {
      "dependsOn": [
        "@ykdz/reference-vike-db#build:template",
        "@ykdz/reference-vike-migrations#build:template",
        "@ykdz/reference-vike-web#build:template",
        "@ykdz/template-core#build",
        "@ykdz/template-environment#build",
        "@ykdz/template-workspace-authoring#build"
      ],
      "tags": ["work:preparation"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["template-dist/**"],
      "persistent": false
    }
  }
}
