{
  "extends": ["//"],
  "tags": ["template-checks"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["dist/**"],
      "persistent": false
    },
    "format:check": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxfmt.config.ts"],
      "outputs": [],
      "persistent": false
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "lint": {
      "dependsOn": [],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"],
      "outputs": [],
      "persistent": false
    },
    "lint:fix": {
      "dependsOn": [],
      "tags": ["work:repair"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "tags": ["quality:light"],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": [],
      "persistent": false
    },
    "check:deployment": {
      "dependsOn": ["check:fixtures"],
      "tags": ["quality:heavy"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false,
      "passThroughEnv": [
        "TEMPLATE_FIXTURE_BUILDKIT_CACHE_DIR",
        "TEMPLATE_FIXTURE_CARGO_CACHE_DIR",
        "TEMPLATE_FIXTURE_CONCURRENCY",
        "TEMPLATE_FIXTURE_DEVELOPMENT_CONTAINER_SESSIONS",
        "TEMPLATE_FIXTURE_EVIDENCE_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_READ",
        "TEMPLATE_FIXTURE_EVIDENCE_WRITE",
        "TEMPLATE_FIXTURE_EVIDENCE_ACTIVITY_DIR",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ID",
        "TEMPLATE_FIXTURE_EVIDENCE_RUN_ATTEMPT",
        "TEMPLATE_FIXTURE_PNPM_CACHE_DIR",
        "TEMPLATE_FIXTURE_WORKSPACE_DIR",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_READ_ONLY",
        "TEMPLATE_FIXTURE_TURBO_REMOTE_CACHE_SIGNATURE_KEY",
        "TEMPLATE_FIXTURE_TURBO_TEAM",
        "TEMPLATE_FIXTURE_TURBO_TOKEN"
      ]
    },
    "check:evidence-health": {
      "dependsOn": [],
      "tags": ["quality:conditional"],
      "cache": false,
      "inputs": [],
      "outputs": [],
      "persistent": false
    },
    "check:fixtures": {
      "dependsOn": ["check:focused"],
      "tags": ["quality:heavy"],
      "cache": false,
      "inputs": [],
      "outputs": [],
