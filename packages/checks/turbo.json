{
  "extends": ["//"],
  "tags": ["template-checks"],
  "tasks": {
    "check:focused": {
      "dependsOn": ["check:generated"]
    },
    "check:fixtures": {
      "dependsOn": ["check:focused"]
    },
    "check:deployment": {
      "dependsOn": ["check:fixtures"]
    },
    "prepare:rustfmt": {
      "tags": ["work:preparation"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"]
    },
    "check:templates": {
      "dependsOn": ["prepare:rustfmt"],
      "env": ["RUSTUP_TOOLCHAIN"]
    }
  }
}
