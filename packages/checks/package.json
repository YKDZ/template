{
  "name": "@ykdz/template-checks",
  "private": true,
  "type": "module",
  "exports": {
    "./development-container-session": {
      "source": "./src/development-container-session.ts",
      "types": "./dist/development-container-session.d.ts",
      "default": "./dist/development-container-session.js"
    },
    "./check-generated-registry": null,
    "./workflow-contract": {
      "source": "./src/workflow-contract.ts",
      "types": "./dist/workflow-contract.d.ts",
      "default": "./dist/workflow-contract.js"
    },
    "./publication-source": {
      "source": "./src/check-publication-source.ts",
      "types": "./dist/check-publication-source.d.ts",
      "default": "./dist/check-publication-source.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:generated": "node --conditions=source src/check-fixture-evidence-architecture.ts && node --conditions=source src/check-generated-registry.ts init",
    "check:focused": "node --conditions=source src/check-fixture-evidence-architecture.ts && node --conditions=source src/check-generated-registry.ts focused",
    "check:deployment": "node --conditions=source src/check-fixture-evidence-architecture.ts && node --conditions=source src/check-generated-registry.ts deployment",
    "check:evidence-health": "node --conditions=source src/check-fixture-evidence-health.ts",
    "check:templates": "node --conditions=source src/check-registry-contract.ts",
    "check:templates:github-yaml": "node --conditions=source scripts/check-builtin-preset-github-yaml.ts",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern dist .",
    "lint:fix": "oxlint --format=unix --ignore-pattern dist . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "node --conditions=source --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter=@ykdz/reference-typescript-config/reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --test --test-concurrency=1 --test-timeout=300000 --test-reporter=spec --test-reporter=@ykdz/reference-typescript-config/reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/**/*.integration.test.ts'",
    "check:generated:output": "node --conditions=source scripts/check-generated-output.ts",
    "diagnose:matrix": "node --conditions=source src/check-generated-registry.ts package-addition-matrix",
    "check:capabilities": "node --conditions=source src/check-fixture-evidence-architecture.ts && node --conditions=source src/check-generated-registry.ts capabilities"
  },
  "dependencies": {
    "@ykdz/template-builtin-presets": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "execa": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@devcontainers/cli": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/reference-typescript-config": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "smol-toml": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:"
  }
}
