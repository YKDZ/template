{
  "name": "@ykdz/template-workspace-authoring",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package-name-projection": {
      "source": "./src/package-name-projection.ts",
      "types": "./dist/package-name-projection.d.ts",
      "default": "./dist/package-name-projection.js"
    },
    "./typescript-module-specifiers": {
      "source": "./src/typescript-module-specifiers.ts",
      "types": "./dist/typescript-module-specifiers.d.ts",
      "default": "./dist/typescript-module-specifiers.js"
    },
    "./content-artifact": {
      "source": "./src/content-artifact.ts",
      "types": "./dist/content-artifact.d.ts",
      "default": "./dist/content-artifact.js"
    },
    "./resource-ignore-snapshot": {
      "source": "./src/resource-ignore-snapshot.ts",
      "types": "./dist/resource-ignore-snapshot.d.ts",
      "default": "./dist/resource-ignore-snapshot.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "sync:resource-ignore-snapshot": "node scripts/sync-resource-ignore-snapshot.ts",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.scripts.json --noEmit --pretty false"
  },
  "dependencies": {
    "typescript": "catalog:public-cli-runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "peerDependencies": {
    "@ykdz/template-core": "workspace:*"
  }
}
