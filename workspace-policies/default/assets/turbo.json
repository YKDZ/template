{
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["app", "library"]
        }
      },
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "globalDependencies": ["oxfmt.config.ts", "oxlint.config.ts"],
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#dev": {
      "tags": ["work:development"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "cache": false,
      "dependsOn": ["//#lint:fix"],
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#publication:artifact": {
      "cache": false,
      "tags": ["quality:conditional"]
    },
    "//#publication:readiness": {
      "cache": false,
      "tags": ["work:release"]
    },
    "//#test:e2e": {
      "cache": false,
      "dependsOn": [
        "@ykdz/reference-hono-api#build",
        "@ykdz/reference-vue-hono-web#build",
        "@ykdz/reference-vue-hono-web#browser:prepare"
      ],
      "tags": ["quality:heavy"]
    },
    "//#toolchain:prepare": {
      "cache": false,
      "tags": ["work:preparation"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
