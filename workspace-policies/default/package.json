{
  "name": "@ykdz/template-workspace",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "assets",
    "scripts",
    "publication",
    "publication-setup",
    "resources"
  ],
  "type": "module",
  "imports": {
    "#npm-publication/*": "./publication/*.ts"
  },
  "exports": {
    "./dependency-catalog": {
      "source": "./src/dependency-catalog.ts",
      "types": "./dist/dependency-catalog.d.ts",
      "default": "./dist/dependency-catalog.js"
    },
    "./publication/*": "./publication/*.ts",
    "./task-gates": "./scripts/task-gates.ts",
    "./project-github": {
      "source": "./src/project-github.ts",
      "types": "./dist/project-github.d.ts",
      "default": "./dist/project-github.js"
    },
    "./application-requirements": {
      "source": "./src/application-requirements.ts",
      "types": "./dist/application-requirements.d.ts",
      "default": "./dist/application-requirements.js"
    },
    "./vue-policy": {
      "source": "./src/vue-policy.ts",
      "types": "./dist/vue-policy.d.ts",
      "default": "./dist/vue-policy.js"
    },
    "./default-environment": {
      "source": "./src/default-environment.ts",
      "types": "./dist/default-environment.d.ts",
      "default": "./dist/default-environment.js"
    },
    "./project-linking": {
      "source": "./src/project-linking.ts",
      "types": "./dist/project-linking.d.ts",
      "default": "./dist/project-linking.js"
    },
    "./release-toolchain-snapshot": {
      "source": "./src/release-toolchain-snapshot.ts",
      "types": "./dist/release-toolchain-snapshot.d.ts",
      "default": "./dist/release-toolchain-snapshot.js"
    },
    "./root-projection": {
      "source": "./src/root-projection.ts",
      "types": "./dist/root-projection.d.ts",
      "default": "./dist/root-projection.js"
    },
    "./default-workspace-strategy": {
      "source": "./src/default-workspace-strategy.ts",
      "types": "./dist/default-workspace-strategy.d.ts",
      "default": "./dist/default-workspace-strategy.js"
    },
    "./default-package-identity": {
      "source": "./src/default-package-identity.ts",
      "types": "./dist/default-package-identity.d.ts",
      "default": "./dist/default-package-identity.js"
    },
    "./joint-e2e": {
      "source": "./src/joint-e2e.ts",
      "types": "./dist/joint-e2e.d.ts",
      "default": "./dist/joint-e2e.js"
    },
    "./package-addition-facts": {
      "source": "./src/package-addition-facts.ts",
      "types": "./dist/package-addition-facts.d.ts",
      "default": "./dist/package-addition-facts.js"
    },
    "./rust-toolchain-facts": {
      "source": "./src/rust-toolchain-facts.ts",
      "types": "./dist/rust-toolchain-facts.d.ts",
      "default": "./dist/rust-toolchain-facts.js"
    },
    "./shared-root-files": {
      "source": "./src/shared-root-files.ts",
      "types": "./dist/shared-root-files.d.ts",
      "default": "./dist/shared-root-files.js"
    },
    "./generation-context": {
      "source": "./src/generation-context.ts",
      "types": "./dist/generation-context.d.ts",
      "default": "./dist/generation-context.js"
    },
    "./package-contribution": {
      "source": "./src/package-contribution.ts",
      "types": "./dist/package-contribution.d.ts",
      "default": "./dist/package-contribution.js"
    },
    "./project-requirements": {
      "source": "./src/project-requirements.ts",
      "types": "./dist/project-requirements.d.ts",
      "default": "./dist/project-requirements.js"
    },
    "./default-package-role": {
      "source": "./src/default-package-role.ts",
      "types": "./dist/default-package-role.d.ts",
      "default": "./dist/default-package-role.js"
    },
    "./reference-package": {
      "source": "./src/reference-package.ts",
      "types": "./dist/reference-package.d.ts",
      "default": "./dist/reference-package.js"
    }
  },
  "scripts": {
    "check:author-planning-roles": "pnpm --workspace-root run author-planning-roles:workspace -- --owner-directory \"$PWD\"",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix .",
    "lint:fix": "oxlint --format=unix . --fix",
    "sync:policy-snapshot": "node scripts/sync-snapshot.ts src/workspace-policy-snapshot.ts",
    "test": "node --conditions=source --experimental-strip-types --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec 'test/**/*.light.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "sync:release-toolchain-snapshot": "node scripts/sync-snapshot.ts src/release-toolchain-snapshot.ts"
  },
  "dependencies": {
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "ignore": "catalog:",
    "jsonc-parser": "catalog:",
    "smol-toml": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/reference-ts-cli": "link:../../references/ts-cli",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semver": "catalog:",
    "spdx-expression-parse": "catalog:",
    "tar": "catalog:",
    "typescript-7": "catalog:"
  }
}
