{
  "name": "Template",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "NODE_VERSION": "24.21.0",
      "RUST_TOOLCHAIN": "1.99.0",
      "PACKAGE_MANAGER_PIN": "pnpm@12.9.1"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "fill-labs.dependi"
      ],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.format.oxc": "always",
          "source.fixAll.oxc": "always"
        },
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "oxc.configPath": "./oxlint.config.ts",
        "oxc.enable": true,
        "oxc.fmt.configPath": "./oxfmt.config.ts",
        "rust-analyzer.cargo.features": "all",
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.procMacro.enable": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      }
    }
  },
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=SYS_ADMIN"
  ],
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "RUST_BACKTRACE": "1"
  },
  "postCreateCommand": {
    "installNodeDependencies": "pnpm install --frozen-lockfile"
  },
  "remoteUser": "root",
  "mounts": [
    {
      "type": "volume",
      "source": "${devcontainerId}-pnpm-store",
      "target": "/pnpm/store"
    },
    {
      "type": "volume",
      "source": "${devcontainerId}-cargo-git",
      "target": "/usr/local/cargo/git"
    },
    {
      "type": "volume",
      "source": "${devcontainerId}-cargo-registry",
      "target": "/usr/local/cargo/registry"
    },
    {
      "type": "volume",
      "source": "${devcontainerId}-target",
      "target": "${containerWorkspaceFolder}/target"
    }
  ]
}
