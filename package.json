{
  "name": "@ykdz/template-repository",
  "private": true,
  "type": "module",
  "scripts": {
    "boundaries": "turbo boundaries",
    "check": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check",
    "author-planning-roles:workspace": "node --conditions=source --experimental-strip-types scripts/check-author-planning-roles.ts",
    "check:full": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check:full",
    "check:heavy": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check:heavy",
    "fix": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts fix",
    "format:check": "oxfmt --list-different --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .devcontainer scripts test",
    "format:write": "oxfmt --write --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .devcontainer scripts test",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern *.config.ts scripts test",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern *.config.ts scripts test --fix",
    "typecheck": "tsc --build --noEmit --pretty false",
    "sync:workspace-policy": "node scripts/sync-workspace-policy.ts",
    "check:workspace-policy": "node scripts/sync-workspace-policy.ts --check",
    "build": "turbo run build --filter=!// --output-logs=errors-only --log-order=grouped",
    "sync:repository": "node --conditions=source scripts/sync-repository-config.ts",
    "check:repository:config": "node --conditions=source scripts/sync-repository-config.ts --check",
    "check:development-container": "node --conditions=source scripts/check-repository-development-container.ts",
    "test:packed-publication": "node scripts/run-packed-publication-test.ts",
    "test": "node --conditions=source --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=source scripts/run-root-integration.ts",
    "test:e2e:cli": "pnpm --filter @ykdz/template run test:e2e:resolution && pnpm --filter @ykdz/template run test:e2e:source",
    "publication:setup": "node --import @ykdz/reference-npm-publication/setup --eval '' --",
    "publication:artifact": "node --import @ykdz/reference-npm-publication/artifact --eval '' --",
    "publication:remote:npm": "node --import @ykdz/reference-npm-publication/schedule-npm --eval '' --",
    "publication:remote:release": "node --import @ykdz/reference-npm-publication/schedule-release --eval '' --",
    "publication:setup:format": "pnpm exec oxfmt --list-different --no-error-on-unmatched-pattern --ignore-path=/dev/null 'scripts/npm-publication-setup/'*",
    "publication:setup:lint": "pnpm exec oxlint --quiet --format=unix --no-ignore --no-error-on-unmatched-pattern 'scripts/npm-publication-setup/'*.ts",
    "publication:setup:typecheck": "pnpm run typecheck",
    "publication:setup:test": "PUBLICATION_TOOL_NAME=@ykdz/reference-npm-publication node --conditions=source --experimental-strip-types --test --test-timeout=60000 --test-reporter=spec 'scripts/npm-publication-setup/**/*.light.test.ts'",
    "database:prepare:dev": "pnpm --filter @ykdz/preset-vike-app run database:prepare:dev",
    "database:prepare:e2e": "pnpm --filter @ykdz/preset-vike-app run database:prepare:e2e",
    "database:prepare:test": "pnpm --filter @ykdz/preset-vike-app run database:prepare:test",
    "toolchain:prepare": "cargo --version",
    "sync": "pnpm run sync:workspace-policy && pnpm run sync:repository"
  },
  "devDependencies": {
    "@devcontainers/cli": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/reference-npm-publication": "workspace:*",
    "@ykdz/reference-tooling-config": "workspace:*",
    "@ykdz/reference-ts-cli": "workspace:*",
    "@ykdz/template-checks": "workspace:*",
    "@ykdz/template-content": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "@ykdz/template-environment": "workspace:*",
    "@ykdz/template-generator": "workspace:*",
    "@ykdz/template-workspace": "workspace:*",
    "@ykdz/template-workspace-authoring": "workspace:*",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "smol-toml": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
