{
  "name": "@ykdz/template-repository",
  "private": true,
  "description": "Repository workspace for the YKDZ template generator.",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!// --output-logs=errors-only --log-order=grouped",
    "check": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check",
    "check:heavy": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check:heavy",
    "check:full": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts check:full",
    "boundaries": "node --conditions=source --experimental-strip-types scripts/run-turbo-boundaries.ts",
    "check:toolchain:versions": "node --conditions=source scripts/check-template-toolchain-versions.ts",
    "fix": "node --conditions=source --experimental-strip-types scripts/run-task-gate.ts fix",
    "format:check": "oxfmt --list-different --config oxfmt.config.ts $(git ls-files -- ':!packages/**')",
    "format:write": "oxfmt --write --config oxfmt.config.ts $(git ls-files -- ':!packages/**')",
    "lint": "oxlint --quiet --format=unix --config oxlint.config.ts oxlint.config.ts oxlint.template-source.config.ts oxfmt.config.ts scripts test-support test",
    "lint:fix": "oxlint --format=unix --config oxlint.config.ts oxlint.config.ts oxlint.template-source.config.ts oxfmt.config.ts scripts test-support test --fix",
    "test": "node --conditions=source --experimental-strip-types --test --test-concurrency=2 --test-timeout=60000 --test-reporter=spec --test-reporter=@ykdz/template-builtin-presets/node-test-count-reporter --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/**/*.light.test.ts'",
    "test:integration": "node --conditions=source --experimental-strip-types scripts/run-root-integration.ts",
    "test:packed-publication": "node --conditions=source --experimental-strip-types scripts/run-packed-publication-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "sync:repository": "node --conditions=source scripts/sync-repository-config.ts",
    "check:repository:config": "node --conditions=source scripts/sync-repository-config.ts --check",
    "check:development-container": "node --conditions=source scripts/check-repository-development-container.ts"
  },
  "devDependencies": {
    "@devcontainers/cli": "catalog:",
    "@types/node": "catalog:",
    "@ykdz/template-builtin-presets": "workspace:*",
    "@ykdz/template-checks": "workspace:*",
    "@ykdz/template-core": "workspace:*",
    "execa": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "smol-toml": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "valibot": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
