{
  "extends": "./tsconfig.config.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    ".pnpmfile.mjs",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test-support/**/*.ts"
  ]
}
